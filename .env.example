# API token from the Smartsupp dashboard (API Tokens); every token has full access to the account. Set it with `smartsupp auth setup`.
SMARTSUPP_API_TOKEN=
# 1 turns write commands on; anything else, or empty, keeps them off.
SMARTSUPP_ALLOW_WRITES=
# auto (default), cli or mcp; the skills read it from the shell environment, not from this file.
SMARTSUPP_ROUTE=
# Override the API base URL (default https://api.smartsupp.com/v2); for tests only.
SMARTSUPP_API_URL=
